# ============================================
# MyExpenses - Variáveis de Ambiente
# ============================================
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env.local
# 2. Preencha os valores (SEM ASPAS!)
# 3. Nunca commite o arquivo .env.local
# 4. Em produção, cadastre as mesmas variáveis na Vercel:
#    Settings → Environment Variables
#
# NODE_ENV e VERCEL_URL são definidas automaticamente
# (pelo Next e pela Vercel): não as coloque aqui.
#
# ============================================

# ============================================
# DATABASE - PostgreSQL (Neon)
# ============================================
#
# Como obter:
# 1. Acesse: https://neon.tech
# 2. Crie um projeto
# 3. Copie a connection string
# 4. IMPORTANTE: Adicione ?sslmode=require no final
#
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

# ============================================
# NEXTAUTH - Autenticação
# ============================================

# Secret: chave para assinar os tokens JWT da sessão
# Como gerar:
#   No terminal: openssl rand -base64 32
#
# ⚠️ IMPORTANTE:
# - Nunca compartilhe esta chave
# - Mínimo 32 caracteres
# - Trocar a chave encerra todas as sessões abertas
#
NEXTAUTH_SECRET=insira-aqui-sua-chave-secreta-com-no-minimo-32-caracteres

# URL: Base URL da aplicação
# Desenvolvimento:
NEXTAUTH_URL=http://localhost:3000
#
# Produção (configurar na Vercel):
# NEXTAUTH_URL=https://seu-app.vercel.app

# ============================================
# GOOGLE OAUTH - Login com Google
# ============================================
#
# Como obter:
# 1. Acesse: https://console.cloud.google.com
# 2. Crie um projeto ou selecione existente
# 3. APIs & Services → Credentials
# 4. Create Credentials → OAuth client ID
# 5. Application type: Web application
# 6. Authorized redirect URIs (adicione ambos):
#    - http://localhost:3000/api/auth/callback/google
#    - https://seu-app.vercel.app/api/auth/callback/google
#
GOOGLE_CLIENT_ID=123456789-abcdefghijklmnop.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-abcdefghijklmnopqrstuvwx

# ============================================
# VERCEL BLOB - Foto de perfil
# ============================================
#
# Como obter:
# 1. Dashboard Vercel → Storage → Create Database
# 2. Selecione "Blob" → Create
# 3. Copie o token que aparece
#
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# E-MAIL - Gmail (verificação, recuperação de senha, contato)
# ============================================
#
# GMAIL_USER: conta que envia os e-mails e recebe as mensagens de contato.
# GMAIL_APP_PASSWORD: senha de app do Google (não é a senha da conta).
#   Como obter: myaccount.google.com → Segurança → Verificação em duas
#   etapas (ativar) → Senhas de app → gerar uma para "MyExpenses".
#
# Sem estas duas, o servidor não inicia o envio de e-mails.
#
GMAIL_USER=seu-email@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop

# ============================================
# APLICAÇÃO
# ============================================
#
# URL pública, gravada nos arquivos de backup e exportação.
#
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# CRONS (vercel.json)
# ============================================
#
# A Vercel envia "Authorization: Bearer <CRON_SECRET>" a cada execução;
# as rotas /api/cron/* recusam a chamada se o valor não bater ou estiver vazio.
# Como gerar: openssl rand -base64 32
#
CRON_SECRET=insira-aqui-um-segredo-aleatorio

# ============================================
# RENDA VARIÁVEL - Cotações (brapi.dev)
# ============================================
#
# Token da API de cotações da B3, usado pelo cron de cotações e pela
# atualização manual. Como obter: crie uma conta em https://brapi.dev
#
BRAPI_API_KEY=seu-token-brapi

# ============================================
# NOTAS IMPORTANTES
# ============================================
#
# ✅ SEMPRE:
# - Use valores SEM aspas
# - Adicione ?sslmode=require na DATABASE_URL
# - Mantenha .env.local no .gitignore
#
# ❌ NUNCA:
# - Commite o arquivo .env.local
# - Compartilhe suas credenciais
# - Exponha NEXTAUTH_SECRET ou CRON_SECRET publicamente
#
# 🔒 SEGURANÇA:
# - Todas as variáveis, exceto NEXT_PUBLIC_*, são secretas
# - Rotacione credenciais periodicamente
# - Prefira valores diferentes em dev e produção (banco e segredos)
#
# ============================================
