# ============================================
# MyExpenses - .gitignore
# ============================================

# === Dependencies ===
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# === Next.js ===
/.next/
/out/
next-env.d.ts
.turbo

# === Build ===
/build
/dist
*.tsbuildinfo
.pnpm-store

# === Testing ===
/coverage
*.lcov

# === Environment Variables ===
# ⚠️ CRÍTICO: Protege secrets e credenciais
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local

# ✅ PERMITIR: Template de exemplo
!.env.example

# === Logs ===
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# === OS Files ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~

# === IDEs ===
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (WebStorm, IntelliJ, etc)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# === Certificates ===
*.pem
*.key
*.cert
*.crt

# === Deploy Platforms ===
.vercel
.netlify

# === Database ===
*.sqlite
*.sqlite3
*.db

# === Drizzle ORM ===
# Ignora migrations locais (se você gerar migrations localmente)
# Descomente se não quiser versionar migrations:
# drizzle/
# migrations/

# Drizzle Studio local cache
.drizzle/

# === Docker ===
# Não ignora docker-compose.yml e Dockerfile
# Ignora apenas dados e logs locais
docker-compose.override.yml

# === AI Assistants (Claude, Gemini, Cursor, etc) ===
# Arquivos de configuração de assistentes de IA
.claude/
.gemini/
.cursor/
CLAUDE.md
AGENTS.md
claude.md
agents.md

# === Backups e Temporários ===
*.bak
*.backup
*.tmp
*.temp
~$*

# === Lock Files ===
# ⚠️ ATENÇÃO: Escolha apenas um gerenciador de pacotes!
#
# Se usar NPM (comentar package-lock.json):
# package-lock.json
#
# Se usar YARN (comentar yarn.lock):
# yarn.lock
#
# Se usar PNPM (manter pnpm-lock.yaml, ignorar os outros):
package-lock.json
yarn.lock

# === TypeScript ===
.tsbuildinfo
next-env.d.ts

# === Local Development ===
.local/
local/
scratch/
playground/
temp/

# === Vercel Blob (uploads temporários) ===
# Se testar uploads localmente
uploads/
.uploads/

# === Sessões e Cache ===
.cache/
.temp/
sessions/

# ============================================
# IMPORTANTE - Arquivo .env.local
# ============================================
#
# ✅ .env.example → DEVE ser commitado (template)
# ❌ .env.local → NUNCA commitar (secrets reais)
#
# Verificar: git status
# Se .env.local aparecer, algo está errado!
#
# ============================================